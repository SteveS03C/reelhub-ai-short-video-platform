page {
  background: linear-gradient(180deg, #f3f6ff 0%, #fbfcff 48%, #f7f9fd 100%);
  color: #1f2d3d;
}

.category-page {
  padding: 28rpx 24rpx 40rpx;
}

.hero {
  padding: 38rpx 30rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #1f3c88 0%, #4a6cf7 45%, #8b5cf6 100%);
  box-shadow: 0 24rpx 50rpx rgba(74, 108, 247, 0.24);
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.hero-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
}

.section-head {
  margin: 34rpx 8rpx 20rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2840;
}

.section-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8190ab;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.channel-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  height: 380rpx;
  background: #dfe6f3;
  box-shadow: 0 18rpx 40rpx rgba(31, 60, 136, 0.1);
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(12, 22, 44, 0.1) 0%, rgba(12, 22, 44, 0.68) 100%);
}

.card-badge {
  position: absolute;
  top: 26rpx;
  left: 24rpx;
  min-width: 96rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.card-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 24rpx 24rpx;
}

.card-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.card-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.86);
}

.card-footer {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-stats {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.card-button {
  min-width: 154rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 18rpx;
  box-sizing: border-box;
}
