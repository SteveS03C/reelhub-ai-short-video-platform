page {
  background: #f5f5f5;
}

.report-page {
  padding: 24rpx;
}

.report-head {
  margin-bottom: 20rpx;
}

.report-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.report-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a7a7a;
  line-height: 1.7;
}

.section {
  background: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.content {
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
}
.content > textarea {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
}

.error-message {
  color: #f00;
  margin-top: 16rpx;
  display: block;
  font-size: 24rpx;
}

.post{
  display:flex;
  flex-direction: row;
  line-height:16px;
  margin-top: 80rpx;
  gap: 24rpx;
}
.post > button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  vertical-align:middle;
  color:white;
  background-color: #408080;
  font-size: 28rpx;
}

.section1{
  width: 100%;
  height:100rpx;
}

.picker {
  width: 100%;
  font-size: 28rpx;
  color: #333333;
}

.picker-value {
  margin-left: 12rpx;
  color: #2f6bff;
  font-weight: 600;
}
