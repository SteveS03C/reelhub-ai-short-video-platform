page {
  font-size: 28rpx;
  background: #f8f9fa;
  color: #333333;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.hero {
  position: relative;
}

.hero-overlay {
  height: 280rpx;
  background: linear-gradient(135deg, #1c1c1c 0%, #3a3a3a 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.profile-card {
  margin: -140rpx 32rpx 0;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.profile-top {
  display: flex;
  align-items: center;
}

.face {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.profile-meta {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #111111;
}

.username {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.profile-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #aaaaaa;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin: 32rpx 32rpx 0;
}

.action-card {
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  text-align: center;
}

.primary-card {
  color: #ffffff;
  background: #222222;
}

.ghost-card {
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  color: #333333;
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.action-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

.privacy-panel {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.privacy-copy {
  flex: 1;
}

.privacy-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}

.privacy-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888888;
}

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 999rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.switch-on {
  background: #222222;
}

.switch-off {
  background: #e0e0e0;
}

.switch-handle {
  position: absolute;
  top: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.switch-handle-on {
  left: 44rpx;
}

.switch-handle-off {
  left: 4rpx;
}

.logout-btn,
.follow-btn {
  margin: 32rpx 32rpx 0;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
}

.logout-btn {
  color: #555555;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.follow-btn {
  color: #ffffff;
  background: #222222;
}

.follow-btn.followed {
  color: #888888;
  background: #f0f0f0;
}

.logout-btn::after,
.follow-btn::after {
  border: none;
}

.content-card {
  margin: 32rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888888;
}

.tabs {
  margin-top: 32rpx;
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #888888;
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
}

.tab-active {
  color: #222222;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #222222;
}

.video-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.video-card {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  height: 380rpx;
  background: #f5f5f5;
}

.video-cover {
  width: 100%;
  height: 100%;
}

.video-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.5) 100%);
}

.video-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.empty-card {
  margin-top: 40rpx;
  padding: 80rpx 0;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #555555;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaaaaa;
}
