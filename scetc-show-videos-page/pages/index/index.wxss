.item-container {
    position: relative;
    margin: 18rpx 18rpx 28rpx 18rpx;
    background: #ffffff;
    border-radius: 18rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 24rpx rgba(12, 37, 96, 0.10);
}

.cover {
    width: 100%;
    height: 400rpx;
    display: block; 
}

.back-img{
    display: block; 
    background: linear-gradient(180deg, #151515, #2a2a2a);
}

.desc {
    margin-top: 0;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    padding: 14rpx 18rpx 16rpx 18rpx;
}

.desc .right {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.desc .faceName {
    display: flex;
    flex-direction: column;
    align-items: center;
    
    margin-left: 10px;
}

.title {
    font-size: 30rpx;
    margin-top: 12rpx;
    margin-left: 0;
    width: 600rpx;
    color: #1f2d3d;
    font-weight: 600;
}

.myface {
    display: block;
    width: 60rpx;
    height: 60rpx;
    border-radius: 30rpx;
    margin-top: 0;
    margin-right: 14rpx;
    border: 2rpx solid #ffffff;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.15);
}

.nickname {
    font-size: 24rpx;
    margin-top: 0;
    margin-right: 0;
    color: #51606f;
    max-width: 560rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
