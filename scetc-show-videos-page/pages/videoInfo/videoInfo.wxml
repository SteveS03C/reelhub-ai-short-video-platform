<view style='width:100%;height:100%;position:relative;'>
  <!-- 视频播放器 -->
  <video id="myVideo" src="{{src}}" style='width:100%;height:100%;' mode="{{cover}}" autoplay="true" loop="true" enable-scroll="false"></video>
  
  <!-- 顶部导航栏 -->
  <view style='position:absolute;top:0;left:0;width:100%;height:100rpx;background-color:rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:space-between;z-index:10;'>
    <view style='display:flex;align-items:center;background-color:rgba(255,255,255,0.3);border-radius:20rpx;padding:10rpx 20rpx;margin-left:20rpx;'>
      <image src='../resource/images/back.png' style='width:30rpx;height:30rpx;margin-right:10rpx;' bindtap='showIndex'></image>
      <text style='color:white;font-size:24rpx;' bindtap='showIndex'>退出</text>
    </view>
    <text style='color:white;font-size:30rpx;'>秀吧life</text>
    <view style='display:flex;align-items:center;'>
      <image src='../resource/images/search.png' style='width:40rpx;height:40rpx;margin-right:20rpx;' bindtap='showSearch'></image>
      <image src='../resource/images/settings.png' style='width:40rpx;height:40rpx;margin-right:20rpx;'></image>
      <!-- 删除按钮，只有视频作者才能看到 -->
      <block wx:if="{{isVideoCreator}}">
        <view style='display:flex;align-items:center;background-color:#ff4d4f;border-radius:20rpx;padding:10rpx 20rpx;margin-right:20rpx;'>
          <image src='../resource/images/delete.png' style='width:30rpx;height:30rpx;margin-right:10rpx;' bindtap='deleteVideo'></image>
          <text style='color:white;font-size:24rpx;' bindtap='deleteVideo'>删除</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 右侧功能按钮 -->
  <view style='position:absolute;right:20rpx;top:30%;display:flex;flex-direction:column;align-items:center;z-index:10;'>
    <image class="face" src='{{imagesrc}}' style='width:80rpx;height:80rpx;border-radius:40rpx;margin-bottom:30rpx;' bindtap='showPublisher'></image>
    <block wx:if="{{userLikeVideo}}">
      <image src='../resource/images/like.png' style='width:60rpx;height:60rpx;margin-bottom:30rpx;' bindtap='likeVideoOrNot'></image>
    </block>
    <block wx:else>
      <image src='../resource/images/unlike.png' style='width:60rpx;height:60rpx;margin-bottom:30rpx;' bindtap='likeVideoOrNot'></image>
    </block>
    <image src='../resource/images/comments.png' style='width:60rpx;height:60rpx;margin-bottom:30rpx;' bindtap='toggleComment'></image>
    <image src='../resource/images/share.png' style='width:60rpx;height:60rpx;margin-bottom:30rpx;' bindtap='shareMe'></image>
    <view class="ai-entry" bindtap="toggleAiAssistant">
      <text class="ai-entry-text">AI助手</text>
    </view>
    <view class="report-entry" bindtap="goReport">
      <text class="report-entry-text">举报</text>
    </view>
  </view>
  
  <!-- 底部视频信息 -->
  <view style='position:absolute;bottom:0;left:0;width:100%;background:linear-gradient(to top, rgba(0,0,0,0.8), transparent);z-index:10;'>
    <!-- 视频信息 -->
    <view style='padding:20rpx;'>
      <view style='color:white;font-size:28rpx;'>@{{videoInfo.nickName}}</view>
      <view style='color:white;font-size:24rpx;margin-top:10rpx;'>{{videoInfo.videoDesc}}</view>
    </view>
  </view>
  
  <!-- 评论区 -->
  <view wx:if="{{showComment}}" style='position:absolute;bottom:0;left:0;width:100%;height:60%;background-color:white;z-index:20; border-top-left-radius:20rpx;border-top-right-radius:20rpx;'>
    <!-- 评论区标题 -->
    <view style='padding:20rpx;border-bottom:1rpx solid #eee;display:flex;align-items:center;justify-content:space-between;'>
      <text style='font-size:28rpx;font-weight:bold;'>评论</text>
      <view style='width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;background-color:#f0f0f0;border-radius:20rpx;' bindtap='toggleComment'>
        <text style='font-size:32rpx;font-weight:bold;color:#333;'>×</text>
      </view>
    </view>
    
    <!-- 评论列表 -->
    <view style='padding:20rpx;height:70%;overflow-y:scroll;'>
      <!-- 显示评论或无评论提示 -->
      <view wx:if="{{CommentList.length === 0}}" style='display:flex;justify-content:center;align-items:center;height:100%;'>
        <text style='font-size:24rpx;color:#999;'>暂无评论，快来发表第一条评论吧！</text>
      </view>
      <view wx:else>
        <view wx:for="{{CommentList}}" class="comment" wx:for-index="idx" wx:for-item="itemName" style='margin-bottom:15rpx;'>
          <view style='display:flex;align-items:center;'>
            <image src='{{itemName.face_image}}' style='width:40rpx;height:40rpx;border-radius:20rpx;margin-right:10rpx;'></image>
            <view style='flex:1;'>
              <view style='font-size:20rpx;color:#000;'>{{itemName.nickName}}</view>
              <view style='font-size:22rpx;margin-top:5rpx;color:#000;'>{{itemName.comment}}</view>
              <view style='font-size:16rpx;color:#999;margin-top:5rpx;'>{{itemName.createTime}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 评论输入框 -->
    <view style='padding:20rpx;border-top:1rpx solid #eee;display:flex;align-items:center;'>
      <image src='../resource/images/noneface.png' style='width:40rpx;height:40rpx;border-radius:20rpx;margin-right:10rpx;'></image>
      <input name="commentContent" class="saySth" placeholder="{{placeholder}}" confirm-type="send" bindconfirm="sendComment" focus='{{commentFocus}}' value='{{contentValue}}' data-replyFatherCommentId='{{replyFatherCommentId}}' data-replyToUserId='{{replyToUserId}}' style='flex:1;border:1rpx solid #ddd;border-radius:20rpx;padding:10rpx 20rpx;'
      />
    </view>
  </view>

  <view wx:if="{{showAiAssistant}}" class="ai-panel">
    <view class="ai-panel-header">
      <text class="ai-panel-title">AI助手</text>
      <view class="ai-panel-close" bindtap="toggleAiAssistant">
        <text class="ai-panel-close-text">×</text>
      </view>
    </view>

    <view class="ai-panel-body">
      <view class="ai-chip-row">
        <view wx:for="{{aiExamples}}" wx:key="*this" class="ai-chip" data-question="{{item}}" bindtap="fillAiQuestion">
          <text class="ai-chip-text">{{item}}</text>
        </view>
      </view>

      <view class="ai-input-row">
        <input class="ai-input" placeholder="例如：这个视频讲了什么？" value="{{aiQuestion}}" bindinput="onAiQuestionInput" />
        <button class="ai-submit" bindtap="askAiAssistant" loading="{{aiLoading}}" disabled="{{aiLoading}}">提问</button>
      </view>

      <view class="ai-answer-box">
        <text wx:if="{{!aiAnswer}}" class="ai-answer-placeholder">输入问题后，AI 会基于当前视频内容给你回答。</text>
        <scroll-view wx:else scroll-y="true" class="ai-answer-scroll">
          <text class="ai-answer-text">{{aiAnswer}}</text>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
