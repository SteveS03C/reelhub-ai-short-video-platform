.ai-entry {
    min-width: 108rpx;
    padding: 14rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(17, 17, 17, 0.82);
    border: 1rpx solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-entry-text {
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 600;
}

.report-entry {
    margin-top: 20rpx;
    min-width: 108rpx;
    padding: 14rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(255, 77, 79, 0.9);
    border: 1rpx solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
}

.report-entry-text {
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 600;
}

.ai-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48%;
    background: #ffffff;
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    z-index: 22;
    display: flex;
    flex-direction: column;
    box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.ai-panel-header {
    padding: 24rpx 28rpx 18rpx;
    border-bottom: 1rpx solid #eeeeee;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ai-panel-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #222222;
}

.ai-panel-close {
    width: 44rpx;
    height: 44rpx;
    border-radius: 22rpx;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-panel-close-text {
    font-size: 30rpx;
    color: #444444;
}

.ai-panel-body {
    flex: 1;
    padding: 20rpx 24rpx 24rpx;
    display: flex;
    flex-direction: column;
}

.ai-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-bottom: 20rpx;
}

.ai-chip {
    padding: 12rpx 18rpx;
    border-radius: 999rpx;
    background: #f5f7fb;
}

.ai-chip-text {
    font-size: 22rpx;
    color: #4064ff;
}

.ai-input-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 20rpx;
}

.ai-input {
    flex: 1;
    min-height: 72rpx;
    padding: 0 22rpx;
    border-radius: 18rpx;
    border: 1rpx solid #d8dbe4;
    background: #ffffff;
    font-size: 24rpx;
    color: #222222;
    box-sizing: border-box;
}

.ai-submit {
    width: 140rpx;
    height: 72rpx;
    line-height: 72rpx;
    padding: 0;
    border-radius: 18rpx;
    background: #2f6bff;
    color: #ffffff;
    font-size: 24rpx;
}

.ai-answer-box {
    flex: 1;
    border-radius: 20rpx;
    background: #f8f9fc;
    padding: 22rpx;
    overflow: hidden;
}

.ai-answer-placeholder {
    font-size: 24rpx;
    color: #8a8f9d;
    line-height: 1.7;
}

.ai-answer-scroll {
    height: 100%;
}

.ai-answer-text {
    font-size: 24rpx;
    color: #1f2430;
    line-height: 1.8;
    white-space: pre-wrap;
}
